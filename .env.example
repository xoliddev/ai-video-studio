# Copy to .env (never commit it). Every gemini_tts.py reads the environment first, then the nearest .env.

# Gemini API (AI Studio) keys for TTS / transcription. Comma-separated: when one key hits its daily
# quota the next one is used, with the same model and voice so the clips stay consistent.
GEMINI_API_KEYS=key1,key2
# GEMINI_API_KEY=single-key   # also accepted

# Vertex AI (only ab-dveloper-reels/video5 and tools/probe_tts*.py; auth via `gcloud auth print-access-token`)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Headless rendering
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# FFMPEG=/usr/bin/ffmpeg        # optional; Python scripts use imageio-ffmpeg's bundled binary
# FFPROBE=/usr/bin/ffprobe      # monkeys-paw-flow-film/edit.py only

# uzbek-audio-series: optional background music track (not included in the repo)
SERIES_MUSIC=

# monkeys-paw-flow-film (external tools that are not part of this repo)
FLOWKIT=
UZTTS_DIR=
# TITLE_FONT=C\:/Windows/Fonts/BOOKOS.TTF
# TITLE_FONT_BOLD=C\:/Windows/Fonts/BOOKOSB.TTF
